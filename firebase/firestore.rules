rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated as an administrator
    function isAdmin() {
      return request.auth != null;
    }

    // Public Pages & Content Read Access (Readable publicly, Writable only by Admin)
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /navigation/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['id', 'name', 'email', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.id is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 3
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() >= 2
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 5
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }
  }
}


