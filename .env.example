# ==============================================================================
# COLLEGE CMS NEW - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Firebase Client Configuration (Required for Web App Runtime & Firestore)
# Safe for client-side bundle exposure via NEXT_PUBLIC_ prefix
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-college-cms.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-college-cms-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-college-cms.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Cloudinary Storage Configuration (Used for Server Upload Endpoint / Media API)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
CLOUDINARY_UPLOAD_PRESET="college_cms_preset"

# Firebase Admin SDK Configuration (Server-only, do NOT use NEXT_PUBLIC_ prefix)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=